{
    "name": "jaocero/activity-timeline",
    "description": "Beautiful activity timelines for Filament infolists, pages and actions, with first-class support for Spatie Activitylog.",
    "keywords": [
        "jaocero",
        "laravel",
        "activity-timeline",
        "timeline",
        "activitylog",
        "filamentphp",
        "filament-infolists",
        "filament-plugin"
    ],
    "homepage": "https://github.com/jaocero/activity-timeline",
    "support": {
        "issues": "https://github.com/jaocero/activity-timeline/issues",
        "source": "https://github.com/jaocero/activity-timeline"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Jay-Are Ocero",
            "email": "199ocero@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "filament/infolists": "^4.0|^5.0",
        "illuminate/contracts": "^11.28|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "nunomaduro/collision": "^8.1",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "spatie/laravel-activitylog": "^4.10|^5.0"
    },
    "suggest": {
        "spatie/laravel-activitylog": "Required to use ActivityLogSection, ActivityTimelinePage and ActivityTimelineAction (^4.10 or ^5.0)."
    },
    "autoload": {
        "psr-4": {
            "JaOcero\\ActivityTimeline\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JaOcero\\ActivityTimeline\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JaOcero\\ActivityTimeline\\ActivityTimelineServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
